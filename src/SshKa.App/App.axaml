<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SshKa.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SshKa.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Палитра: белый, но с лёгким серым оттенком -->
            <Color x:Key="AppBackgroundColor">#F0F0F0</Color>
            <Color x:Key="PanelBackgroundColor">#F7F7F7</Color>
            <Color x:Key="LineColor">#C6C6C6</Color>
            <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelBackgroundColor}" />
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#CDEBC9" />
            <SolidColorBrush x:Key="StoppedBrush" Color="#F4C7C3" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3B78C2" />

            <!-- Шрифты: простые системные -->
            <FontFamily x:Key="UiFont">Segoe UI, Noto Sans, DejaVu Sans, Arial</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Noto Sans, DejaVu Sans, Arial</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="TreeViewItemIndent">22</x:Double>
            <!-- меньше пустого места слева в дереве сессий -->
            <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">2,0,4,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://SshKa.App/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
